@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(libuv CONFIG)
find_dependency(OpenSSL)
if(@CHHTTP_ENABLE_COMPRESSION@)
  find_dependency(ZLIB)
  find_dependency(zstd CONFIG)
  include("${CMAKE_CURRENT_LIST_DIR}/chhttpFindBrotli.cmake")
  if(NOT chhttp_BROTLI_FOUND)
    set(chhttp_FOUND FALSE)
    set(chhttp_NOT_FOUND_MESSAGE "chhttp requires Brotli encoder and decoder libraries")
    return()
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/chhttpTargets.cmake")
